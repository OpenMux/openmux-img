# Build artefacts (chroot state, sysroot, image output)
work/
dist/

# Python bytecode cache (generated by build/parse-buildspec.py)
__pycache__/
*.pyc

# Repo layer's GPG key is provisioned per build (never commit one)
layer/openmux-repo/sources/openmux.gpg

# Password material
*.pass
*.passwd

# Customer build specs contain credentials - never commit them (the commented
# sample stays, see buildspec.example.yaml)
*buildspec*.yaml
!buildspec.example.yaml

# Hooks materialized at build time from the build spec (hooks/.keep keeps the
# directory; any other committed <phase>* file in it would be intentional)
hooks/customize94-openmux-users
hooks/customize95-openmux-postinstall
