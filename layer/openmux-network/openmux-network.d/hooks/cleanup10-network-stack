#!/bin/sh
# Final network state of an OpenMux image: netplan states the configuration and the
# `renderer` key chooses the daemon - systemd-networkd for what this image ships,
# NetworkManager for any netdef that names it. NetworkManager and iwd ship installed,
# configured and NOT started, because nothing in the shipped config or on the shipped
# hardware needs them at boot; this hook's job is to leave
# `systemctl enable --now NetworkManager` working for whoever needs them. /bin/sh,
# as in every runner hook here: the shell behind /bin/sh has no arrays.
#
# cleanup phase on purpose: setup, packages, every layer's customize hooks in plan
# order, then every layer's cleanup hooks. This therefore runs after the device
# layer's .network files and after whatever the layers enabled, whatever the plan
# order is.
set -eu

ROOT="${1:?usage: cleanup10-network-stack <chroot-dir>}"

fail() { printf 'openmux-network: %s\n' "$1" >&2; exit 1; }

# --- the wireless half has to be ENABLEABLE --------------------------------
# Nothing here checks an enablement: the state this layer produces is "not started",
# so what has to be true is the ability to start - the unit files exist and nothing in
# /etc stands over them. The package checks stay because their failure is otherwise
# silent: a unit enable-units cannot find reports "Unit ... not found. Skipping" and
# exits 0, and a missing wifi.backend shows up only when a network has to be
# associated - iwd is the only Supplicant this image could have, wpa_supplicant being
# uninstalled with Recommends off build-wide.
#
# Test with -x on an executable and -f on a unit file, never -e on a symlink that
# lives in the image: those point at absolute in-chroot paths and this hook runs
# outside the chroot, where one names the build container's own systemd.
[ -x "$ROOT/usr/sbin/NetworkManager" ] ||
   fail "$ROOT/usr/sbin/NetworkManager is not installed - network-manager is a Requires-level layer of openmux-network, so its package is missing for a reason unrelated to this hook"

for unit in NetworkManager.service iwd.service; do
   [ -f "$ROOT/usr/lib/systemd/system/$unit" ] ||
      fail "$ROOT/usr/lib/systemd/system/$unit is missing - 'systemctl enable --now NetworkManager' is how this image turns Wi-Fi on, and that stays one command only while the unit files are where systemd looks"
   [ ! -L "$ROOT/etc/systemd/system/$unit" ] ||
      fail "$ROOT/etc/systemd/system/$unit is a symlink (-> $(readlink "$ROOT/etc/systemd/system/$unit" 2>/dev/null || true)) - a mask there makes somebody else's enable command fail, and this layer turns a daemon off, not out of reach"
done

grep -qx 'wifi.backend=iwd' "$ROOT/etc/NetworkManager/conf.d/iwd.conf" 2>/dev/null ||
   fail "$ROOT/etc/NetworkManager/conf.d/iwd.conf does not set wifi.backend=iwd - without iwd (or wpa_supplicant, which is not installed) NetworkManager has no Wi-Fi Supplicant, and an image that cannot associate a WPA network is only detectable by booting it"

# --- NetworkManager settings -----------------------------------------------
# conf.d, never /etc/NetworkManager/NetworkManager.conf: that file is a conffile
# and editing it turns every future package update into a conffile prompt in a
# non-interactive image.
install -d -m 0755 "$ROOT/etc/NetworkManager/conf.d"
cat > "$ROOT/etc/NetworkManager/conf.d/10-openmux.conf" <<'EOF'
# Written by the openmux-network image layer. Configured connections live in
# /etc/NetworkManager/system-connections (0600, one file per connection);
# nothing is baked into the image.

[main]
# The distro conffile loads the ifupdown plugin too, and ifupdown is not
# installed here: keyfile is the only settings store this image has.
plugins=keyfile
# DNS stays with systemd-resolved, which /etc/resolv.conf points at as its
# stub. NetworkManager writing resolv.conf itself would leave that symlink
# pointing at a stub nothing feeds.
dns=systemd-resolved
EOF

# --- netplan is the configuration surface ----------------------------------
# The addressing is declared once, in netplan, so one YAML file plus
# `netplan apply`/`netplan diff` is the operator's interface and the `renderer` key
# alone decides which daemon applies it. At network level that key covers every
# netdef that does not name a renderer itself; netplan merges the directory per key,
# lexically later file wins, so a site file can move one device or the whole config
# to NetworkManager without editing this one. Either way
# cleanup20-netplan-render runs the real generator over the merged result, so the
# verdict is known at build time rather than at first boot.
#
# For a networkd netdef the generator writes
# /run/systemd/network/10-netplan-end0.network (networkd's own internal DHCP client,
# no client package; DNS goes to resolved, which this layer requires) and enables the
# daemon itself, per boot, as /run/systemd/generator/multi-user.target.wants/
# systemd-networkd.service. Nothing under /etc is written for networkd because
# nothing under /etc decides it - see the two sections below. The udev deny rule the
# generator also writes is inert on this image, which is why cleanup20 derives
# NetworkManager's deny list from the generated output instead.
#
# Mode 0600: netplan's generator warns "Permissions for <file> are too open"
# otherwise, and that warning would be in every device's journal at every boot.
install -d -m 0755 "$ROOT/etc/netplan"
cat > "$ROOT/etc/netplan/01-openmux.yaml" <<'EOF'
# OpenMux: netplan describes the configuration; the renderer key chooses which
# daemon applies it. Override this with another file in this directory (netplan
# merges them; per key, the lexically later file wins) and apply it with
# `netplan apply` - from the serial console, because applying a change restarts
# the daemon that owns the interface you are connected through.
#
# networkd is stated rather than left to netplan's default so this file says who
# owns end0. A single device can still name `renderer: NetworkManager` on its own
# netdef - that is how a wlan0 or modem entry is written - without moving the rest.
#
# end0 is the name udev gives this board's wired port, and the key of a netdef is
# the name netplan matches on. If `ip -br link` shows the wired port under another
# name, this key is what has to go with it: a netdef keyed to a name the port does
# not have describes nothing, and reports that nowhere.
network:
  version: 2
  renderer: networkd
  ethernets:
    end0:
      dhcp4: true
#
# The wireless half - NetworkManager and iwd - is installed and configured but not
# started, because no netdef here names a wireless interface. To add one, start the
# daemon and describe the interface:
#
#     systemctl enable --now NetworkManager
#     then a file in this directory with `renderer: NetworkManager` on that device
#
# Starting NetworkManager does not take end0 away: conf.d/20-openmux-networkd.conf
# denies NetworkManager exactly the interfaces netplan renders with networkd, so
# `nmcli device` lists end0 as unmanaged and this file stays the only description
# of it. A cellular modem would also need modemmanager, which this image does not
# install.
#
# Asked to KEEP a connection (nmcli connection modify/add, nmtui), NetworkManager
# writes its own file into this directory, 90-NM-<uuid>.yaml. It is generated from
# the profile, so it is not edited by hand, and `nmcli connection delete <name>`
# removes it - not rm.
EOF
chmod 600 "$ROOT/etc/netplan/01-openmux.yaml"

# end0 only, on purpose: Wi-Fi cannot be written here without an SSID and a PSK, and
# credentials do not belong in a shipped image, so wlan0 stays with the connections
# its operator creates at runtime, on the daemon that stays off until asked for.
# Nothing asks for IPv6 either, which leaves networkd's default
# `LinkLocalAddressing=ipv6` - a fe80:: address and no route.

# The key is the one fact in the file, and it is a match condition and nothing else:
# the generated .network name, the udev rule, wait-online's `-i <name>` drop-in and
# NetworkManager's deny list are all derived from it. Keyed to a name the port does
# not have - which is what `ip -br link` on the board says it has - the netdef matches
# nothing, every derived name points at a port that is not there, and the port is left
# to whichever daemon has no rule about it while the YAML reads perfectly. A build
# cannot check the name: udev gives it on a board, and nothing under $ROOT is
# authoritative for it. cleanup20-netplan-render runs the generator over the key as
# written, which is the closest a build can come.

# Checked rather than trusted: a file that lost its renderer line, or its mode,
# still looks correct in a listing.
np="$ROOT/etc/netplan/01-openmux.yaml"
grep -qx '  renderer: networkd' "$np" 2>/dev/null ||
   fail "$np does not state renderer: networkd - the owner of end0 would then come from a default defined elsewhere"
[ "$(stat -c '%a' "$np" 2>/dev/null)" = 600 ] ||
   fail "$np is not mode 600 - netplan would warn on every boot"

# NetworkManager's own netplan files must not ship. Such a file names a renderer for
# its device, so a box carrying one has a port whose owner is decided by a file nobody
# wrote, while a fresh build of the same source decides it from 01-openmux.yaml.
# NetworkManager is never started during a build, so one present here came from a host
# tree - an overlay, or key_file/post_install.
stray=$(find "$ROOT/etc/netplan" -maxdepth 1 -name '90-NM-*' -print 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')
if [ -n "$stray" ]; then
   fail "an NM-generated netplan profile would ship in this image: $stray - remove it from the source (delete the connection with nmcli, not by hand)"
fi

# --- the wireless half is off at boot --------------------------------------
# Both units arrive enabled: the upstream network-manager layer runs
# `$BDEBSTRAP_HOOKS/enable-units "$1" NetworkManager` - whose [Install] Also= also
# links NetworkManager-wait-online.service and the nm-dispatcher alias - and the
# upstream iwd layer runs `$BDEBSTRAP_HOOKS/enable-units "$1" iwd`. Neither has a job
# on a shipped board: end0 is networkd's by the renderer key, there is no wireless
# interface for iwd to serve, and modemmanager is not installed, so a cellular netdef
# has no daemon either. Left enabled they add two daemons, two D-Bus names and an
# nl80211 handler to every boot of hardware that cannot use them.
#
# Removed from the target rather than masked, which is the whole difference for the
# operator: masking makes `systemctl enable` itself fail until somebody runs
# `systemctl unmask`, and adding a Wi-Fi card is a decision for the person holding the
# card. The command above starts the daemon and iwd comes with it unasked - Debian
# ships /usr/share/dbus-1/system-services/net.connman.iwd.service with
# `SystemdService=iwd.service`, so the first call to net.connman.iwd activates
# iwd.service (Type=dbus, BusName=net.connman.iwd) by itself. The nm-dispatcher alias
# in /etc/systemd/system stays: it is not an enable, its unit has no [Install]
# WantedBy, and a bare `systemctl start NetworkManager` still needs that step.
#
# NetworkManager-wait-online.service goes with them: its 60 s ceiling
# (NM_ONLINE_TIMEOUT) lands on network-online.target, which rescue-ssh.target and
# wg-quick@.service want - a headless board with no cable in the port must not lose a
# minute there. Dropped, not masked, because a masked unit something still Wants= is a
# failed dependency job. Enabling NetworkManager re-links it, which is the right way
# round: the operator asked for the link-up wait.
#
# systemd-networkd-wait-online.service is left alone deliberately: for a networkd
# netdef the generator adds it to the target under /run every boot, so an /etc entry
# is not what puts it there and masking it would only produce the failed job above.
for unit in NetworkManager.service NetworkManager-wait-online.service iwd.service; do
   rm -f "$ROOT"/etc/systemd/system/*.wants/"$unit"
done

# An absence, so a glob that matched nothing cannot stand as the verdict. Same
# no--e rule as above: on these paths it would ask the build container's systemd about
# its own units.
for unit in NetworkManager.service iwd.service; do
   left=$(ls "$ROOT"/etc/systemd/system/*.wants/"$unit" 2>/dev/null | tr '\n' ' ')
   [ -z "$left" ] ||
      fail "$unit is still wanted by $left - the wireless half would start on every boot to manage interfaces this board does not have, which is the state this step exists to remove"
done

# --- networkd's own .network files must not survive ------------------------
# The engine's device layer writes them with `$LAYER_HOOKS/systemd/netgen eth0` and
# `netgen wlan0` into the two fixed paths below (layer/rpi/device/family-base.yaml),
# whatever the board's ports are called - which is why this hook is in cleanup: the
# files have to be gone after that hook, not before it.
#
# /etc/systemd/network is networkd's own config source, read without netplan, so a
# leftover applies alongside netplan's /run/systemd/network/10-netplan-<name>.network:
# one port described twice, two DHCP clients, two sets of routes, and `netplan apply`
# neither reads nor removes the /etc one. `wlan0` is the live name of the Wi-Fi a site
# adds, so both paths go.
rm -f "$ROOT/etc/systemd/network/01-eth0.network"
rm -f "$ROOT/etc/systemd/network/02-wlan0.network"

# --- /etc keeps no opinion about networkd ----------------------------------
# Neither masked nor enabled: the renderer key is the switch and the generator
# operates it per boot, under /run. `systemctl enable`/`disable` are therefore not the
# levers here and neither wins an argument with the YAML, so the state to produce is
# silence in /etc. What must not be present is a leftover OPINION, because each one
# outranks the renderer key and none of them is visible in the YAML:
#   * a mask (a symlink to /dev/null) is the loudest failure this image can have:
#     netplan would still write end0's .network and still ask for the daemon, a masked
#     unit is never started, and the device boots with no wired address and a failed
#     job while its netplan file reads perfectly;
#   * a .wants entry - a hand `systemctl enable`, or
#     /usr/lib/systemd/system-preset/90-systemd.preset, which ships `enable
#     systemd-networkd.service`, `-wait-online` and `-network-generator` - starts the
#     daemon on every boot even for a config that names NetworkManager everywhere;
#   * dbus-org.freedesktop.network1.service, networkd's [Install] Alias, which is also
#     the unit `networkctl` starts through D-Bus activation.
# Unit names, split on spaces below - no globbing and no spaces in a unit name.
networkd_units='systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service systemd-network-generator.service dbus-org.freedesktop.network1.service'

# rm/readlink rather than systemctl: this phase's mounts belong to mmdebstrap, so the
# hook needs neither /proc nor a bus in the chroot.
for unit in $networkd_units; do
   rm -f "$ROOT"/etc/systemd/system/*.wants/"$unit"
   if [ "$(readlink "$ROOT/etc/systemd/system/$unit" 2>/dev/null || true)" = /dev/null ]; then
      rm -f "$ROOT/etc/systemd/system/$unit"
   fi
done

# Checked rather than trusted: each removal is a no-op if a path moves, and what is
# asserted is an ABSENCE, which no listing shows unless every path is looked at.
for unit in $networkd_units; do
   p="$ROOT/etc/systemd/system/$unit"
   state=$(readlink "$p" 2>/dev/null || true)
   [ "$state" != /dev/null ] ||
      fail "$unit is still masked ($p -> /dev/null): netplan would enable networkd and systemd would refuse to start it, so the image would have no wired address"
   [ ! -L "$p" ] ||
      fail "$unit is a symlink in /etc/systemd/system (-> $state): a mask or an alias rewrite there outranks the netplan renderer key"
   wanted=$(ls "$ROOT"/etc/systemd/system/*.wants/"$unit" 2>/dev/null || true)
   [ -z "$wanted" ] ||
      fail "$unit is wanted by $wanted with nothing in netplan asking for it: a preset or a hand enable starts networkd on every boot whatever the renderer says"
done

# --- what udev is left to name ---------------------------------------------
# udev names the interfaces here, not the kernel alone: no net.ifnames=0 reaches the
# kernel cmdline, so what udev is configured to do is what happens. These two null
# .link files come from the engine's minimal-systemd stack
# (layer/sys-apps/systemd-net-min.yaml) and are kept because the state they produce is
# about udev, not about which daemon renders netplan: a masked .link is never parsed,
# so 99-default.link's NamePolicy= never runs and 73-usb-net-by-mac.link never offers
# enx<mac>, and a plug-in provisioning adapter or gadget keeps the name it arrived
# with. Losing them is quiet - what notices is a config that names an interface by its
# old name.
#
# The wired port is named by neither file: it is `end0` with these masks in place, and
# `networkctl status end0` reports `Link File: n/a` on a board. That name has to be
# the key in 01-openmux.yaml, which is why the key is checked there rather than here:
# a rename of the GMAC would leave the netdef, the generated names and the deny list
# describing a port that is not there, and the port to whichever daemon has no rule
# about it. No build can confirm a name - only a board, through udev - so these links
# are checked for their state and the key is checked by the generator run.
install -d -m 0755 "$ROOT/etc/systemd/network"
ln -sfn /dev/null "$ROOT/etc/systemd/network/99-default.link"
ln -sfn /dev/null "$ROOT/etc/systemd/network/73-usb-net-by-mac.link"

for link in 99-default.link 73-usb-net-by-mac.link; do
   state=$(readlink "$ROOT/etc/systemd/network/$link" 2>/dev/null || true)
   [ "$state" = /dev/null ] ||
      fail "$ROOT/etc/systemd/network/$link points at '${state:-nothing}', not /dev/null"
done

exit 0
