ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", ENV{ID_USB_INTERFACE_NUM}=="00", ATTRS{serial}=="OMX[0-9]*-A", PROGRAM="/bin/sh -c 's=%s{serial}; echo ${s%-A}'", SYMLINK+="openmux/%c/port1"
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", ENV{ID_USB_INTERFACE_NUM}=="01", ATTRS{serial}=="OMX[0-9]*-A", PROGRAM="/bin/sh -c 's=%s{serial}; echo ${s%-A}'", SYMLINK+="openmux/%c/port2"
