ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6011", ENV{ID_USB_INTERFACE_NUM}=="03", ATTRS{serial}=="OMX[0-9]*-B", PROGRAM="/bin/sh -c 's=%s{serial}; echo ${s%-B}'", SYMLINK+="openmux/%c/port8"

